# Virtual Environment
.venv/

# Python
__pycache__/
*.pyc

# Model Files
*.pkl

# Logs
*.log
logs/

# VS Code
.vscode/

# Streamlit
.streamlit/

# Dataset — large CSVs and PCAPs should not be in version control
datasets/**/*.csv
datasets/**/*.pcap
datasets/captures/
datasets/cicids2017/

# Temporary
temp/

# Received files (file transfer output - not source code)
received_files/

# TLS certificates — private key MUST NOT be committed
certs/server.key
# certs/server.crt is intentionally NOT ignored (safe to share with clients)
